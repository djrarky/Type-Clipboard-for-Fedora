#!/usr/bin/env bash
set -euo pipefail

text="$(wl-paste --no-newline 2>/dev/null || true)"
[[ -z "${text}" ]] && exit 0

sleep 0.25

engine="$(ibus engine 2>/dev/null || true)"
layout=""
variant=""
if [[ "${engine}" == xkb:* ]]; then
  IFS=':' read -r _ layout variant _lang <<<"${engine}"
fi

layout_state_file="${XDG_RUNTIME_DIR:-/tmp}/type-clipboard.layout"
restarted_or_started=0
export DOTOOL_PIPE="${DOTOOL_PIPE:-${XDG_RUNTIME_DIR:-/tmp}/dotool-pipe}"

if command -v systemctl >/dev/null 2>&1; then
  if [[ "${engine}" == xkb:* ]]; then
    desired_layout_state="${layout}:${variant}"
    current_layout_state=""
    if [[ -r "${layout_state_file}" ]]; then
      current_layout_state="$(<"${layout_state_file}")"
    fi

    if [[ "${desired_layout_state}" != "${current_layout_state}" ]]; then
      systemctl --user set-environment "DOTOOL_XKB_LAYOUT=${layout}"
      if [[ -n "${variant}" ]]; then
        systemctl --user set-environment "DOTOOL_XKB_VARIANT=${variant}"
      else
        systemctl --user unset-environment "DOTOOL_XKB_VARIANT" || true
      fi
      systemctl --user restart dotoold.service
      restarted_or_started=1
      printf '%s' "${desired_layout_state}" >"${layout_state_file}"
    fi
  fi

  if ! systemctl --user is-active --quiet dotoold.service; then
    systemctl --user start dotoold.service
    restarted_or_started=1
  fi
fi

if [[ "${restarted_or_started}" -eq 1 ]]; then
  sleep 0.2
fi

mapfile -t lines <<<"${text//$'\r'/}"

emit_dotool_commands() {
  for i in "${!lines[@]}"; do
    printf 'type %s\n' "${lines[$i]}"
    if (( i < ${#lines[@]} - 1 )); then
      printf 'key enter\n'
    fi
  done
}

for _ in 1 2 3; do
  if emit_dotool_commands | dotoolc; then
    exit 0
  fi

  sleep 0.2
done

exit 1
