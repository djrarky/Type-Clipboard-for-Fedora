[Unit]
Description=ydotoold (virtual keyboard via /dev/uinput) - group gated
ConditionPathExists=/dev/uinput
After=multi-user.target

[Service]
Type=simple
# Pre-start runs as root; main runs as the service account
PermissionsStartOnly=yes
ExecStartPre=/usr/bin/chgrp uinput /dev/uinput
ExecStartPre=/usr/bin/chmod 0660 /dev/uinput

User=ydotoold
Group=ydotool
SupplementaryGroups=uinput

# /run/ydotoold owned by ydotoold:ydotool (0770)
RuntimeDirectory=ydotoold
RuntimeDirectoryMode=0770

# group-gated socket in /run; use short flags for widest compatibility
ExecStart=/usr/bin/ydotoold -p /run/ydotoold/socket -P 0660
Restart=on-failure

# We need access to /dev
PrivateDevices=no

[Install]
WantedBy=multi-user.target
